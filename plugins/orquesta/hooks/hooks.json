{
  "description": "Orquesta: recuerda las tareas sin verificar al empezar y no deja cerrar con tareas a medias.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/sesion-inicio.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/cierre.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
